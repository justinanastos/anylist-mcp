<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>ANYLIST_LIST_NAME</key>
		<string>Grocery List</string>
		<key>CF_ACCESS_AUD</key>
		<string>__CF_ACCESS_AUD__</string>
		<key>HOME</key>
		<string>/Users/justin</string>
		<key>NODE_ENV</key>
		<string>production</string>
		<key>OP_SERVICE_ACCOUNT_TOKEN</key>
		<string>__OP_SERVICE_ACCOUNT_TOKEN__</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.justin.anylist-mcp</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/node</string>
		<string>src/remote/main.ts</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/anylist-mcp.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/anylist-mcp.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/justin/proj/anylist-mcp</string>
</dict>
</plist>
